{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facetforge.local/format/1.0/manifest.schema.json",
  "title": "FacetForge .ffp manifest, version 1",
  "description": "Normative shape of manifest.json inside a version-1 .ffp document bundle. Unknown object members are permitted everywhere and must survive a rewrite.",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "documentVersion",
    "createdAt",
    "modifiedAt",
    "generator",
    "document",
    "geometry"
  ],
  "properties": {
    "format": { "const": "facetforge-document" },
    "formatVersion": { "type": "integer", "minimum": 1, "maximum": 1 },
    "documentVersion": { "type": "integer", "minimum": 1 },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "modifiedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "generator": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "format": { "type": "string" }
      },
      "additionalProperties": true
    },
    "document": { "$ref": "#/$defs/document" },
    "geometry": { "$ref": "#/$defs/geometry" }
  },
  "additionalProperties": true,
  "$defs": {
    "document": {
      "type": "object",
      "required": [
        "schemaVersion",
        "name",
        "displayUnit",
        "materials",
        "rootNodes",
        "displayModes",
        "layers",
        "measurements"
      ],
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "displayUnit": { "enum": ["millimetres", "inches"] },
        "materials": {
          "type": "array",
          "items": { "$ref": "#/$defs/material" }
        },
        "rootNodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        },
        "displayModes": { "type": "object" },
        "layers": {
          "type": "array",
          "items": { "$ref": "#/$defs/layer" }
        },
        "currentLayerID": { "$ref": "#/$defs/uuid" },
        "measurements": { "type": "array" }
      },
      "additionalProperties": true
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "point3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      },
      "additionalProperties": true
    },
    "rgba": {
      "type": "object",
      "required": ["red", "green", "blue", "alpha"],
      "properties": {
        "red": { "type": "number", "minimum": 0, "maximum": 1 },
        "green": { "type": "number", "minimum": 0, "maximum": 1 },
        "blue": { "type": "number", "minimum": 0, "maximum": 1 },
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    },
    "transform": {
      "type": "object",
      "required": ["translation", "rotation", "scale"],
      "properties": {
        "translation": { "$ref": "#/$defs/point3" },
        "rotation": { "$ref": "#/$defs/point3" },
        "scale": { "$ref": "#/$defs/point3" }
      },
      "additionalProperties": true
    },
    "material": {
      "type": "object",
      "required": ["id", "name", "baseColor", "metallic", "roughness"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string" },
        "baseColor": { "$ref": "#/$defs/rgba" },
        "metallic": { "type": "number", "minimum": 0, "maximum": 1 },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    },
    "layer": {
      "type": "object",
      "required": ["id", "name", "color", "isVisible", "isLocked"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string" },
        "color": { "$ref": "#/$defs/rgba" },
        "isVisible": { "type": "boolean" },
        "isLocked": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": ["id", "name", "transform", "isVisible", "children"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string" },
        "transform": { "$ref": "#/$defs/transform" },
        "isVisible": { "type": "boolean" },
        "materialID": { "$ref": "#/$defs/uuid" },
        "layerID": { "$ref": "#/$defs/uuid" },
        "kind": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      },
      "additionalProperties": true
    },
    "geometry": {
      "type": "object",
      "required": ["buffers", "nodes"],
      "properties": {
        "buffers": {
          "type": "array",
          "items": { "$ref": "#/$defs/buffer" }
        },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/geometryReference" }
        }
      },
      "additionalProperties": true
    },
    "buffer": {
      "type": "object",
      "required": ["path", "byteLength", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^geometry/[A-Za-z0-9._-]+$"
        },
        "byteLength": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": true
    },
    "geometryReference": {
      "type": "object",
      "required": ["nodeID", "buffer", "offset", "length", "kind"],
      "properties": {
        "nodeID": { "$ref": "#/$defs/uuid" },
        "buffer": { "type": "integer", "minimum": 0 },
        "offset": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["curve", "mesh"] }
      },
      "additionalProperties": true
    }
  }
}
